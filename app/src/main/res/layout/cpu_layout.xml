<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/cpuLL"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_margin="12dp">
    <android.support.v7.widget.CardView xmlns:card_view="http://schemas.android.com/apk/res-auto"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="?android:attr/selectableItemBackground"
        android:onClick="governorClickMethod"
        card_view:cardBackgroundColor="#232323"
        card_view:cardCornerRadius="4dp">
        <LinearLayout
            android:orientation="vertical"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center_vertical"
                    android:layout_width="100sp"
                    android:layout_height="match_parent"
                    android:text="@string/StringLayout_governor"/>
                <Spinner
                    android:id="@+id/governerSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </LinearLayout>
            <TextView
                android:textSize="15sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/StringLayoutDesc_governor"/>
        </LinearLayout>
    </android.support.v7.widget.CardView>
    <android.support.v7.widget.CardView xmlns:card_view="http://schemas.android.com/apk/res-auto"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:foreground="?android:attr/selectableItemBackground"
        android:onClick="maxFreqClickMethod"
        card_view:cardBackgroundColor="#232323"
        card_view:cardCornerRadius="4dp">
        <LinearLayout
            android:orientation="vertical"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center_vertical"
                    android:layout_width="100sp"
                    android:layout_height="match_parent"
                    android:text="@string/StringLayout_max_freq"/>
                <Spinner
                    android:id="@+id/maxFreqSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </LinearLayout>
            <TextView
                android:textSize="15sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/StringLayoutDesc_max_freq"/>
        </LinearLayout>
    </android.support.v7.widget.CardView>
    <android.support.v7.widget.CardView xmlns:card_view="http://schemas.android.com/apk/res-auto"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:foreground="?android:attr/selectableItemBackground"
        android:onClick="minFreqClickMethod"
        card_view:cardBackgroundColor="#232323"
        card_view:cardCornerRadius="4dp">
        <LinearLayout
            android:orientation="vertical"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center_vertical"
                    android:layout_width="100sp"
                    android:layout_height="match_parent"
                    android:text="@string/StringLayout_min_freq"/>
                <Spinner
                    android:id="@+id/minFreqSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </LinearLayout>
            <TextView
                android:textSize="15sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/StringLayoutDesc_min_freq"/>
        </LinearLayout>
    </android.support.v7.widget.CardView>
    <android.support.v7.widget.CardView xmlns:card_view="http://schemas.android.com/apk/res-auto"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:foreground="?android:attr/selectableItemBackground"
        android:onClick="multicorePSClickMethod"
        card_view:cardCornerRadius="4dp">
        <CheckBox
            android:id="@+id/mcps"
            android:padding="4dp"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/StringLayout_multicore_power_saving"
            android:onClick="multicorePS_method"/>
    </android.support.v7.widget.CardView>
    <ToggleButton
        android:id="@+id/cpu0Toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:checked="true"
        android:textOn="@string/cpu0on"
        android:textOff="@string/cpu0DOWN"
        android:onClick="xml_method_toggle_cpu_n"/>
    <ToggleButton
        android:id="@+id/cpu1Toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:checked="true"
        android:textOn="@string/cpu1on"
        android:textOff="@string/cpu1DOWN"
        android:onClick="xml_method_toggle_cpu_n"/>
    <ToggleButton
        android:id="@+id/cpu2Toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:checked="true"
        android:textOn="@string/cpu2on"
        android:textOff="@string/cpu2DOWN"
        android:onClick="xml_method_toggle_cpu_n"/>
    <ToggleButton
        android:id="@+id/cpu3Toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:checked="true"
        android:textOn="@string/cpu3on"
        android:textOff="@string/cpu3DOWN"
        android:onClick="xml_method_toggle_cpu_n"/>
    <ToggleButton
        android:id="@+id/cpu4Toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:checked="true"
        android:textOn="@string/cpu4on"
        android:textOff="@string/cpu4DOWN"
        android:onClick="xml_method_toggle_cpu_n"/>
    <ToggleButton
        android:id="@+id/cpu5Toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:checked="true"
        android:textOn="@string/cpu5on"
        android:textOff="@string/cpu5DOWN"
        android:onClick="xml_method_toggle_cpu_n"/>
    <ToggleButton
        android:id="@+id/cpu6Toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:checked="true"
        android:textOn="@string/cpu6on"
        android:textOff="@string/cpu6DOWN"
        android:onClick="xml_method_toggle_cpu_n"/>
    <ToggleButton
        android:id="@+id/cpu7Toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:checked="true"
        android:textOn="@string/cpu7on"
        android:textOff="@string/cpu7DOWN"
        android:onClick="xml_method_toggle_cpu_n"/>
    <ToggleButton
        android:id="@+id/cpu8Toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:checked="true"
        android:textOn="@string/cpu8on"
        android:textOff="@string/cpu8DOWN"
        android:onClick="xml_method_toggle_cpu_n"/>
    <ToggleButton
        android:id="@+id/cpu9Toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:checked="true"
        android:textOn="@string/cpu9on"
        android:textOff="@string/cpu9DOWN"
        android:onClick="xml_method_toggle_cpu_n"/>
</LinearLayout>
